# terraform.tfvars.example
#
# Copy this file to terraform.tfvars and adjust values to match your
# OpenStack environment before running the deployment.
#
#   cp terraform/terraform.tfvars.example terraform/terraform.tfvars
#
# All variables below have defaults in variables.tf. Only override the ones
# that differ from the defaults in your environment.

# Name prefix applied to all created resources (network, VMs, security group, etc.)
# cluster_name = "k8s-cluster"

# Name of the Glance image to use for all nodes.
# Must already exist in your OpenStack project.
# The setup-openstack-environment.sh script uploads this as "ubuntu-noble".
image_name = "ubuntu-noble"

# Flavor names for master and worker nodes.
# The setup-openstack-environment.sh script creates "my-large" (2 vCPU, 4 GB RAM, 8 GB disk).
flavor_master = "my-large"
flavor_worker = "my-large"

# Number of worker nodes to create.
# worker_count = 2

# Name of the OpenStack keypair to create (auto-generated by Terraform).
# ssh_key_name = "k8s-cluster-key"

# Name of the external (public) network in your OpenStack environment.
# This is the network that floating IPs are allocated from.
public_network_name = "public"

# CIDR for the private cluster network created by Terraform.
# Must not overlap with your OpenStack management or external networks.
# network_cidr = "192.168.100.0/24"

# OS username on the cloud image (ubuntu for Ubuntu cloud images).
# ssh_user = "ubuntu"
